{
  "name": "lad-music",
  "version": "0.3.1",
  "private": true,
  "description": "Клиент Яндекс Музыки для Яндекс Станции",
  "main": "electron/main.cjs",
  "author": "Lad",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "node scripts/desktop.cjs",
    "pack": "python3 scripts/build.py",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.2.8",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.lad.music",
    "productName": "Лад",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/lad-backend",
        "to": "backend"
      },
      {
        "from": "backend",
        "to": "backend-source",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Лад находит Яндекс Станцию в локальной сети и управляет музыкой.",
        "NSBonjourServices": [
          "_yandexio._tcp"
        ]
      },
      "icon": "public/icon.png"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/KiriDey0/Lad.git",
    "directory": "apps/macos"
  },
  "homepage": "https://github.com/KiriDey0/Lad",
  "bugs": "https://github.com/KiriDey0/Lad/issues"
}
